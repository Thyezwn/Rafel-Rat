<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules file for Android 14+ compatibility.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- ✅ السماح بنسخ احتياطي للإعدادات -->
    <include domain="sharedpref" path="."/>
    
    <!-- ✅ السماح بنسخ احتياطي لقواعد البيانات -->
    <include domain="database" path="."/>
    
    <!-- ✅ السماح بنسخ احتياطي للملفات الداخلية -->
    <include domain="file" path="."/>
    
    <!-- ❌ استبعاد الملفات الخارجية (SD Card) -->
    <exclude domain="external" path="."/>
    
    <!-- ❌ استبعاد الملفات الجذرية -->
    <exclude domain="root" path="."/>
</full-backup-content>
